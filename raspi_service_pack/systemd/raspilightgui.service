[Unit]
Description=Raspberry Pi OLED system dashboard
After=local-fs.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment=HOME=@SERVICE_HOME@
Environment=PYTHONUNBUFFERED=1
Environment=GPIOZERO_PIN_FACTORY=lgpio
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/lightGUI.py --backend hardware
Restart=always
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
