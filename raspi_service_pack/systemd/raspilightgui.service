[Unit]
Description=Raspberry Pi OLED control panel and RGB status LED
DefaultDependencies=no
After=local-fs.target
Before=basic.target multi-user.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment=HOME=@SERVICE_HOME@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/lightGUI.py
Restart=always
RestartSec=1
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
