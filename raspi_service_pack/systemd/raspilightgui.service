[Unit]
Description=Raspberry Pi OLED control panel and RGB status LED
DefaultDependencies=no
After=local-fs.target dev-i2c\x2d1.device
Requires=dev-i2c\x2d1.device
Before=basic.target multi-user.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment=HOME=@SERVICE_HOME@
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_ROOT@/.venv/bin/python @REPO_ROOT@/lightGUI.py
Restart=always
RestartSec=1
TimeoutStopSec=10
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
