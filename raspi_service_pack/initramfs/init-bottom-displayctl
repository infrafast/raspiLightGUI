#!/bin/sh
set -u

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

STATUS=/run/raspilightgui-initramfs.status
TARGET_DIR="${rootmnt:-/root}/var/lib/raspilightgui"
TARGET="$TARGET_DIR/initramfs-status"

[ -r "$STATUS" ] || exit 0
mkdir -p "$TARGET_DIR" 2>/dev/null || exit 0
cp "$STATUS" "$TARGET" 2>/dev/null || true

exit 0
