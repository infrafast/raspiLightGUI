#!/bin/sh
set -u

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in
  prereqs) prereqs; exit 0 ;;
esac

# Never make OLED feedback a boot dependency. Load the userspace I2C interface,
# then wait for /dev/i2c-1 to be created. udevadm wait returns immediately when
# the device exists; the timeout is only a fail-open guard.
modprobe i2c_designware_platform >/dev/null 2>&1 || true
modprobe i2c_dev >/dev/null 2>&1 || true

if command -v udevadm >/dev/null 2>&1; then
  udevadm wait --timeout=5 /dev/i2c-1 >/dev/null 2>&1 || true
fi

if [ -x /usr/local/bin/displayctl ] && [ -e /dev/i2c-1 ]; then
  /usr/local/bin/displayctl boot >/dev/null 2>&1 || true
fi

exit 0
