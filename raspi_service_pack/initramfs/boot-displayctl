#!/bin/sh
set -u

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
  prereqs) prereqs; exit 0 ;;
esac

# Never make OLED feedback a boot dependency. Load the userspace I2C interface,
# then wait long enough for the Raspberry Pi 5 RP1/DesignWare adapter and
# /dev/i2c-1 node to appear before attempting DisplayCTL. Always fail open.
modprobe i2c_designware_platform >/dev/null 2>&1 || true
modprobe i2c_dev >/dev/null 2>&1 || true

n=0
while [ ! -e /dev/i2c-1 ] && [ "$n" -lt 100 ]; do
  sleep 0.05
  n=$((n + 1))
done

if [ -x /usr/local/bin/displayctl ] && [ -e /dev/i2c-1 ]; then
  /usr/local/bin/displayctl boot >/dev/null 2>&1 || true
fi

exit 0
